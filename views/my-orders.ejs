<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Orders | Shree Shyam Coffee</title>

  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/my-orders.css">
</head>
<body>
  <%- include("partials/header") %>

  <main class="orders-page">
    <section class="orders-heading">
      <p class="orders-eyebrow">YOUR COFFEE JOURNEY</p>
      <h1>My Orders</h1>
      <p>Track your orders and revisit your coffee favourites.</p>
      <a class="order-more-button" href="/products">+ Order More Coffee</a>
    </section>

    <% if (!orders || orders.length === 0) { %>
      <section class="orders-empty">
        <div class="empty-cup">☕</div>
        <h2>No orders yet</h2>
        <p>Your next favourite coffee is just a few clicks away.</p>
        <a class="orders-button" href="/products">Explore Menu</a>
      </section>
    <% } else { %>
      <section class="orders-list">
        <% orders.forEach((order) => { %>
          <article class="order-card">
            <div class="order-top">
              <div>
                <p class="order-label">Order ID</p>
                <strong class="order-id"><%= order._id %></strong>
              </div>

              <div class="order-total">
                <p class="order-label">Total</p>
                <strong>₹<%= Number(order.total || 0).toFixed(2) %></strong>
              </div>
            </div>

            <div class="order-items">
              <% (order.items || []).forEach((item) => { %>
                <div class="order-item">
                  <span><%= item.name %> × <%= item.quantity %></span>
                  <span>₹<%= (
                    Number(item.price || 0) * Number(item.quantity || 0)
                  ).toFixed(2) %></span>
                </div>
              <% }) %>
            </div>

            <div class="order-customer-details">
              <p><strong>Name:</strong> <%= order.customerName %></p>
              <p><strong>Phone:</strong> <%= order.phone %></p>
              <p><strong>Address:</strong> <%= order.address %></p>
            </div>

            <div class="order-bottom">
              <span>
                Placed:
                <%= order.createdAt
                  ? new Date(order.createdAt).toLocaleDateString("en-IN")
                  : "Date unavailable" %>
              </span>

              <span class="order-status status-<%= String(order.status || "Pending").toLowerCase() %>">
                <%= order.status || "Pending" %>
              </span>
            </div>
          </article>
        <% }) %>
      </section>
    <% } %>
  </main>

  <%- include("partials/footer") %>
</body>
</html>